FROM mambaorg/micromamba:2.0.5

ARG FAMSA_VERSION=2.2.3
ARG CLIPKIT_VERSION=2.7.0
ARG IQTREE_VERSION=2.3.6

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash coreutils procps \
    && rm -rf /var/lib/apt/lists/*
USER $MAMBA_USER

RUN micromamba install -y -n base \
        -c conda-forge \
        -c bioconda \
        "famsa=${FAMSA_VERSION}" \
        "clipkit=${CLIPKIT_VERSION}" \
        "iqtree=${IQTREE_VERSION}" \
    && micromamba clean --all --yes

ENV PATH=/opt/conda/bin:${PATH}

RUN micromamba run -n base famsa --help >/dev/null \
    && micromamba run -n base clipkit --help >/dev/null \
    && micromamba run -n base iqtree --help >/dev/null \
    && ps --version >/dev/null

WORKDIR /work