FROM mambaorg/micromamba:1.5.10-jammy

USER root

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        coreutils \
        findutils \
        gawk \
        grep \
        openssh-client \
        sed \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN micromamba create --yes --name generax \
        --channel conda-forge \
        --channel bioconda \
        'generax=2.0.4' \
        'openmpi=4.1.*' \
        'python=3.11.*' \
    && micromamba clean --all --yes

ENV PATH=/opt/conda/envs/generax/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/conda/envs/generax/lib
ENV OMPI_MCA_btl_vader_single_copy_mechanism=none
ENV OMPI_MCA_btl=^openib

RUN command -v generax \
    && command -v mpiexec \
    && command -v python3 \
    && command -v ssh

USER $MAMBA_USER
WORKDIR /work

ENTRYPOINT []
CMD ["bash"]
