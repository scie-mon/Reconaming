manifest {
    name = 'scie-mon/Reconaming'
    description = 'Ortholog-aware multigene-family reconciliation and naming pipeline'
    mainScript = 'main.nf'
}

params {
    input_mode        = 'annotation'
    species_inputs    = null
    ir_gff            = null
    protein_fasta     = null
    sequence_species  = null
    isoform_selection = null
    outdir            = 'results'

    species_tree             = null
    species_tree_container   = 'reconaming-species-tree:dev'
    busco_lineage            = null
    busco_auto_lineage       = true
    busco_mode               = 'auto'
    busco_threads            = 4
    busco_warn_complete      = 90
    species_tree_threads     = 4
    species_tree_bootstrap   = 1000
    species_tree_min_taxa    = 3
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    shell = ['/bin/bash', '-euo', 'pipefail']
}

profiles {
    test {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
        docker.runOptions = "-u ${System.getenv('NXF_HOST_UID') ?: '1000'}:${System.getenv('NXF_HOST_GID') ?: '1000'}"
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}
