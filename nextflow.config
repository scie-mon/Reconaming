manifest {
    name = 'scie-mon/Reconaming'
    description = 'Ortholog-aware multigene-family reconciliation and naming pipeline'
    mainScript = 'main.nf'
}

// Central pipeline configuration. Naming-core options live only in conf/reconaming_opt.ctl.
params {
    // Development defaults for a 64-CPU host. Replace before release/site deployment.
    process_cpus = [
        PREPARE_PROTEINS:          1,
        RUN_BUSCO:                16,
        RUN_BUSCO_PHYLOGENOMICS:  64,
        INFER_SUPERMATRIX_TREE:   64,
        ALIGN_PROTEINS:           64,
        INFER_GENE_TREE:          64,
        RECONCILE_GENE_TREE:      32
    ]
    // IQ-TREE gene-tree -T value: AUTO or a positive integer <= INFER_GENE_TREE CPUs.
    iqtree_threads = 'AUTO'

    sequence_inputs  = 'test/spec_tree/test_species_tree_inputs.tsv'
    annotation          = 'test/spec_tree/merged.rev0.gff3'
    protein_fasta   = null
    id_species      = null
    selection_table = null
    outgroup_genes  = 'test/spec_tree/outgroup_genes.txt'
    outdir          = 'results_bundle2_final'

    revision_registry    = null
    revision_tag         = 'bundle2_final'
    reconaming_opt       = "${projectDir}/conf/reconaming_opt.ctl"
    reconaming_container = 'reconaming-core:6.2'
    gff_output           = null // Route default: update for annotation; none for protein.

    gene_id_attribute       = 'ID'
    transcript_id_attribute = 'ID'
    protein_id_attribute    = ''

    species_tree             = null
    species_tree_container   = 'reconaming-species-tree:dev'
    busco_lineage            = null
    busco_mode               = 'auto'
    busco_warn_complete      = 90
    species_tree_bootstrap   = 1000
    species_tree_outgroup    = null

    gene_tree_container = 'reconaming-gene-tree:0.1.0'
    famsa_args          = ''
    iqtree_args         = ''
    generax_rec_model = 'UndatedDL'
    generax_strategy  = 'SPR'
    generax_seed      = 12345
    generax_args      = ''
    // Permit MPI ranks to exceed Open MPI's recognised slot count.
    generax_oversubscribe = true
    generax_container = 'reconaming-generax:2.0.4'
}

process {
    executor = 'local'
    cpus = 1 // Default for serial helper processes.
    errorStrategy = 'terminate'
    maxRetries = 0
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: gene_tree {
        container = params.gene_tree_container
    }
}

profiles {
    test {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
        docker.runOptions = "-u ${System.getenv('NXF_HOST_UID') ?: '1000'}:${System.getenv('NXF_HOST_GID') ?: '1000'}"
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}
