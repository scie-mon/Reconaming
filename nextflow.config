manifest {
    name = 'scie-mon/Reconaming'
    description = 'Ortholog-aware multigene-family reconciliation and naming pipeline'
    mainScript = 'main.nf'
}

params {
    input_mode      = 'annotation'
    species_inputs  = null
    annotation          = null
    protein_fasta   = null
    id_species      = null
    selection_table = null
    outgroup_genes  = null
    outdir          = 'results'

    gene_id_attribute       = 'ID'
    transcript_id_attribute = 'ID'
    protein_id_attribute    = ''

    species_tree             = null
    species_tree_container   = 'reconaming-species-tree:dev'
    busco_lineage            = null
    busco_auto_lineage       = true
    busco_mode               = 'auto'
    busco_threads            = 4
    busco_warn_complete      = 90
    species_tree_threads     = 4
    species_tree_bootstrap   = 1000
    species_tree_min_taxa    = 3
    species_tree_outgroup    = null

    gene_tree_container = 'reconaming-gene-tree:0.1.0'
    famsa_args          = ''
    iqtree_args         = ''

    generax_cpus      = 64
    generax_rec_model = 'UndatedDL'
    generax_strategy  = 'SPR'
    generax_seed      = 12345
    generax_args      = ''
    generax_container = 'reconaming-generax:2.0.4'
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: gene_tree {
        container = params.gene_tree_container
    }
}

profiles {
    test {
        process.executor = 'local'
    }
    docker {
        docker.enabled = true
        docker.runOptions = "-u ${System.getenv('NXF_HOST_UID') ?: '1000'}:${System.getenv('NXF_HOST_GID') ?: '1000'}"
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}
